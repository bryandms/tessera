{
  "expo": {
    "name": "Tessera Demo",
    "slug": "tessera-demo",
    "version": "0.1.0",
    "scheme": "tessera",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "io.github.bryandms.tessera",
      "supportsTablet": true,
      "appleTeamId": "6G32AHR7QA"
    },
    "android": {
      "package": "io.github.bryandms.tessera",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064E3B"
      }
    },
    "plugins": ["expo-router", "expo-status-bar"]
  }
}
